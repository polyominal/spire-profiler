// ── Harmony patches ──────────────────────────────────────────────────────
// Each postfix is a thin forwarder; keep them exception-free so a profiler
// bug can never break the game's own logic.

[HarmonyPatch(typeof(CombatHistory), nameof(CombatHistory.CardPlayStarted))]
internal static class PatchCardPlayStarted
{
    [HarmonyPostfix]
    private static void Postfix(CardPlay cardPlay)
    {
        try
        {
            // Every player's plays count (team-as-one-player); the slot
            // (CardPlay.Player) keeps the core's per-slot play stacks apart
            // so the interleaved plays of a co-op round stay balanced.
            var card = cardPlay?.Card;
            ProfilerNative.OnCardPlayStarted(
                card?.Id?.Entry ?? "",
                cardPlay?.PlayIndex ?? 0,
                cardPlay?.PlayCount ?? 1,
                card?.GetHashCode() ?? 0,
                SpireProfilerMod.PlayerSlot(cardPlay?.Player));
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] CardPlayStarted: {ex}"); }
    }
}

[HarmonyPatch(typeof(CombatHistory), nameof(CombatHistory.CardPlayFinished))]
internal static class PatchCardPlayFinished
{
    [HarmonyPostfix]
    private static void Postfix(CardPlay cardPlay)
    {
        try
        {
            // Every player's play finish is forwarded; the slot
            // (CardPlay.Player) restores the play_depth bookkeeping balance
            // — a remote play finishing during a local play's choice
            // suspension pops the remote slot's stack, never the local one.
            ProfilerNative.OnCardPlayFinished(SpireProfilerMod.PlayerSlot(cardPlay?.Player));
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] CardPlayFinished: {ex}"); }
    }
}

[HarmonyPatch(typeof(CombatHistory), nameof(CombatHistory.DamageReceived))]
internal static class PatchDamageReceived
{
    [HarmonyPostfix]
    private static void Postfix(Creature receiver, Creature dealer, DamageResult result, CardModel cardSource)
    {
        try { SpireProfilerMod.ForwardDamage(receiver, dealer, result, cardSource); }
        catch (Exception ex) { Log.Error($"[SpireProfiler] DamageReceived: {ex}"); }
    }
}

[HarmonyPatch(typeof(Hook), nameof(Hook.AfterDamageGiven))]
internal static class PatchKillBlowDamage
{
    [HarmonyPostfix]
    private static void Postfix(Creature dealer, DamageResult results, Creature target, CardModel cardSource)
    {
        try
        {
            // CreatureCmd guards CombatHistory.DamageReceived with
            // IsInProgress && !IsEnding, so the hit that kills the last
            // enemy never fires it and would be lost entirely (damage +
            // kill both missing). Hook.AfterDamageGiven is documented in
            // the game source to fire from that same combat-ending hit.
            // Forward only killing blows that DamageReceived did NOT
            // record: non-final kills still fire DamageReceived normally,
            // and IsEnding is a pure function of state (no alive primary
            // enemies), so it is already true at postfix time.
            if (results?.WasTargetKilled != true) return;
            if (!CombatManager.Instance.IsEnding) return;
            SpireProfilerMod.ForwardDamage(target, dealer, results, cardSource);
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] AfterDamageGiven: {ex}"); }
    }
}

[HarmonyPatch(typeof(CombatHistory), nameof(CombatHistory.BlockGained))]
internal static class PatchBlockGained
{
    [HarmonyPostfix]
    private static void Postfix(Creature receiver, int amount, CardPlay cardPlay)
    {
        try
        {
            if (!(receiver?.IsPlayer ?? false)) return;
            // cardPlay is non-null iff the gain was directly caused by a card
            // play (CreatureCmd.GainBlock's documented contract, verified
            // against the game source: relic/power procs like Anchor and
            // DaughterOfTheWind pass null). Every player's gains are
            // forwarded; the receiver slot (receiver.Player) keeps per-slot
            // block pools keyed on who gained the block, so an ally block
            // credits the ally's pool even though the card play that caused
            // it belongs to another slot. The row's SOURCE slot is the card
            // play's card owner when card-caused, else the receiver's own
            // slot (procs have no card owner).
            int sourceSlot = cardPlay?.Card?.Owner != null
                ? SpireProfilerMod.PlayerSlot(cardPlay.Card.Owner)
                : SpireProfilerMod.PlayerSlot(receiver.Player);
            ProfilerNative.OnBlockGained(amount, cardPlay?.Card?.Id?.Entry ?? "", SpireProfilerMod.PlayerSlot(receiver.Player), sourceSlot);
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] BlockGained: {ex}"); }
    }
}

[HarmonyPatch(typeof(CombatManager), nameof(CombatManager.SetUpCombat))]
internal static class PatchSetUpCombat
{
    [HarmonyPostfix]
    private static void Postfix(ICombatState state)
    {
        try
        {
            var encounter = state?.Encounter;
            ProfilerNative.OnCombatStarted(
                encounter?.Id?.Entry ?? "unknown",
                (encounter?.RoomType.ToString() ?? "normal").ToLowerInvariant());
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] SetUpCombat: {ex}"); }
    }
}

[HarmonyPatch(typeof(CombatRoom), nameof(CombatRoom.OnCombatEnded))]
internal static class PatchCombatEnded
{
    [HarmonyPostfix]
    private static void Postfix()
    {
        try { ProfilerNative.OnCombatEnded(); }
        catch (Exception ex) { Log.Error($"[SpireProfiler] OnCombatEnded: {ex}"); }
    }
}

