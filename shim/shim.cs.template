/// Shared run-start postfix body for the four RunManager.SetUp* patches:
/// the run meta (profile id + build commit) must reach the core before the
/// run record it will stamp is opened, then the record is opened with the
/// roster (character ids + NetIds, positional), the run identity, and the
/// resumed flag (true only for the SetUpSaved* variants). Plain helper
/// class — no class-level [HarmonyPatch], so the auto-patch loop skips it.
internal static class RunStartPatches
{
    internal static void NotifyRunStarted(RunState state, bool isResume)
    {
        // The game's run id IS its own StartTime: assigned in
        // RunManager.InitializeShared (UtcNow for a fresh run, the
        // original run's start for a resume), already set before these
        // SetUp* postfixes run. Forwarding it makes run-history matching
        // exact — both sides carry the same integer by provenance. The
        // read degrades to 0 on any failure; the core then stamps its own
        // clock, the pre-forwarding behavior.
        long startTime = 0;
        try
        {
            startTime = Traverse.Create(RunManager.Instance)?.Field("_startTime")?.GetValue<long>() ?? 0;
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] NotifyRunStarted.StartTime: {ex}"); }

        // The slot registry must exist before the first combat event; run
        // start is the earliest event (and re-fires on resume, refilling
        // the same session-immutable player list).
        SpireProfilerMod.CaptureRunPlayers(state);
        ProfilerNative.OnSetRunMeta(SpireProfilerMod.CurrentProfileId());
        ProfilerNative.OnRunStarted(
            SpireProfilerMod.CharacterIds(state),
            state?.AscensionLevel ?? 0,
            state?.GameMode.ToString() ?? "Standard",
            state?.Rng?.StringSeed ?? "",
            isResume,
            SpireProfilerMod.NetIds(state),
            startTime);
    }
}

// ── Attribution catalog patcher ─────────────────────────────────────────
// Every relic/power hook listed in the attribution catalog is wrapped
// in a source-context begin/end pair so damage and block produced outside
// a card play can be attributed to the relic or power that caused them.
// The prefix stores the pushed source id in __state so the postfix only
// pops when the prefix actually pushed (nested hooks stay balanced).

internal static class AttributionPatcher
{
    private const string RelicNamespace = "MegaCrit.Sts2.Core.Models.Relics";
    private const string PowerNamespace = "MegaCrit.Sts2.Core.Models.Powers";

    private static readonly string[] RelicEntries = new[]
    {
@RELIC_ENTRIES@    };

    private static readonly string[] PowerEntries = new[]
    {
@POWER_ENTRIES@    };

    [HarmonyPrefix]
    private static void RelicPrefix(AbstractModel __instance, out string __state)
    {
        __state = SpireProfilerMod.TryBeginContext(__instance, ProfilerNative.ContextKindRelic);
    }

    [HarmonyPostfix]
    private static void RelicPostfix(string __state)
    {
        SpireProfilerMod.TryEndContext(__state);
    }

    [HarmonyPrefix]
    private static void PowerPrefix(AbstractModel __instance, out string __state)
    {
        __state = SpireProfilerMod.TryBeginContext(__instance, ProfilerNative.ContextKindPower);
    }

    [HarmonyPostfix]
    private static void PowerPostfix(string __state)
    {
        SpireProfilerMod.TryEndContext(__state);
    }

    public static void PatchAll(Harmony harmony)
    {
        foreach (var entry in RelicEntries) TryPatch(harmony, entry, RelicNamespace, "RelicPrefix", "RelicPostfix");
        foreach (var entry in PowerEntries) TryPatch(harmony, entry, PowerNamespace, "PowerPrefix", "PowerPostfix");
    }

    private static void TryPatch(Harmony harmony, string entry, string ns, string prefixName, string postfixName)
    {
        try
        {
            var parts = entry.Split('|');
            var className = parts[0];
            var methodName = parts[1];
            var fullName = className.IndexOf('.') >= 0 ? className : ns + "." + className;
            var type = typeof(SpireProfilerMod).Assembly.GetType(fullName) ?? typeof(ModManager).Assembly.GetType(fullName);
            if (type == null)
            {
                Log.Warn($"[SpireProfiler] catalog: type not found: {fullName}");
                return;
            }
            var method = AccessTools.Method(type, methodName);
            if (method == null)
            {
                Log.Warn($"[SpireProfiler] catalog: {type.Name}.{methodName} not found, skipping");
                return;
            }
            var prefix = new HarmonyMethod(typeof(AttributionPatcher).GetMethod(prefixName, System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Static));
            var postfix = new HarmonyMethod(typeof(AttributionPatcher).GetMethod(postfixName, System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Static));
            harmony.Patch(method, prefix, postfix);
        }
        catch (Exception ex)
        {
            Log.Warn($"[SpireProfiler] catalog: failed to patch {entry}: {ex.Message}");
        }
    }
}
// ── Event-forwarding patches ────────────────────────────────────────────
// Orb triggers are async, so they use prefix-only wrappers that set a
// fallback source in the core (cleared when any other attribution source
// appears) instead of push/pop contexts.
[HarmonyPatch(typeof(Hook), nameof(Hook.AfterSideTurnStart))]
internal static class PatchTurnStart
{
    [HarmonyPrefix]
    private static void Prefix(CombatSide side)
    {
        try
        {
            // AfterPlayerTurnStart fires once PER PLAYER per round
            // (CombatManager.SetupPlayerTurn) and would inflate the combat
            // turn counter by the player count. AfterSideTurnStart fires
            // once per side switch per round (CombatManager.StartTurn), so
            // the player-side event is exactly the round boundary — the
            // export means rounds, and extra turns
            // (which re-run SetupPlayerTurn without advancing RoundNumber)
            // don't count. A round is team-scoped, so no slot.
            if (side != CombatSide.Player) return;
            ProfilerNative.OnTurnStarted();
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] AfterSideTurnStart: {ex}"); }
    }
}
[HarmonyPatch(typeof(CombatHistory), nameof(CombatHistory.OrbChanneled))]
internal static class PatchOrbChanneled
{
    [HarmonyPostfix]
    private static void Postfix(OrbModel orb)
    {
        try
        {
            // Orbs are per-player (PlayerCombatState.OrbQueue, OrbModel
            // .Owner); every player's channels land in the team-merged
            // orb-source table, tagged with the owning slot so the per-slot
            // orb fallback only ever seizes its own slot's triggers.
            if (orb == null) return;
            ProfilerNative.OnOrbChanneled(orb.GetHashCode(), SpireProfilerMod.PlayerSlot(orb.Owner));
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] OrbChanneled: {ex}"); }
    }
}
[HarmonyPatch(typeof(Hook), nameof(Hook.AfterBlockCleared))]
internal static class PatchBlockPoolClear
{
    [HarmonyPrefix]
    private static void Prefix(Creature creature)
    {
        try
        {
            // Block is per creature, and every player's block clears at
            // their turn boundaries; the slot keeps the core's block pools
            // per player so a remote player's clear can no longer wipe the
            // local pool (block_effective attribution stays per player).
            if ((creature?.IsPlayer ?? false))
                ProfilerNative.OnBlockPoolClear(SpireProfilerMod.PlayerSlot(creature.Player));
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] AfterBlockCleared: {ex}"); }
    }
}
/// <summary>
/// Potion context: CombatHistory.PotionUsed fires only after the potion's
/// OnUse completes (inside PotionModel.OnUseWrapper, verified against the
/// v0.111.0 source) — too late for power attribution, because potions like
/// FlexPotion apply their powers during OnUse. Prefix OnUseWrapper instead
/// so the potion fallback exists before the effects run; the PotionUsed
/// postfix below only bumps the potions_used counter.
/// </summary>
[HarmonyPatch(typeof(PotionModel), nameof(PotionModel.OnUseWrapper))]
internal static class PatchPotionContextBegin
{
    [HarmonyPrefix]
    private static void Prefix(PotionModel __instance)
    {
        try
        {
            // Potions are per-player (PotionModel.Owner); every player's
            // potions carry the owner's slot so the per-slot potion
            // fallback never captures another player's effects.
            if (__instance == null) return;
            ProfilerNative.OnPotionContextBegin(__instance.Id?.Entry ?? "UNKNOWN_POTION", SpireProfilerMod.PlayerSlot(__instance.Owner));
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] PotionContextBegin: {ex}"); }
    }
}
[HarmonyPatch(typeof(CombatHistory), nameof(CombatHistory.PotionUsed))]
internal static class PatchPotionUsed
{
    [HarmonyPostfix]
    private static void Postfix(PotionModel potion)
    {
        try
        {
            if (potion == null) return;
            ProfilerNative.OnPotionUsed(potion.Id?.Entry ?? "UNKNOWN_POTION", SpireProfilerMod.PlayerSlot(potion.Owner));
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] PotionUsed: {ex}"); }
    }
