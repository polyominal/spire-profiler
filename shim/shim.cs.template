/// <summary>
/// Card origins: when a card is generated for combat by the player (e.g.
/// Creative AI, White Noise), record its instance hash so a later play of
/// the generated card attributes to the generating source (resolved in
/// the core from the active card / hook context).
/// </summary>
[HarmonyPatch(typeof(Hook), nameof(Hook.AfterCardGeneratedForCombat))]
internal static class PatchCardGenerated
{
    [HarmonyPostfix]
    private static void Postfix(CardModel card, Player creator)
    {
        try
        {
            // The hook carries the generating player explicitly
            // (Hook.AfterCardGeneratedForCombat's creator, nullable — a
            // null creator resolves to 0, the single-player degenerate
            // case). The generated instance is tagged with the GENERATOR's
            // slot so the core credits the generator's row when the copy is
            // played — the generator's slot, never re-derived at play time
            // (a generated card's Owner changes when the card transfers
            // between players).
            if (card == null) return;
            // The source is resolved in the core from the active card / hook
            // context; the hook itself carries no explicit source.
            ProfilerNative.OnCardGenerated(card.GetHashCode(), "", 0, SpireProfilerMod.PlayerSlot(creator));
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] CardGenerated: {ex}"); }
    }
}

/// <summary>
/// Forge attribution: every ForgeCmd.Forge call (FurnacePower, Fencing
/// Manual, etc.) records its source model; the core credits the source's
/// ledger entry with the forge amount.
/// </summary>
[HarmonyPatch(typeof(ForgeCmd), nameof(ForgeCmd.Forge))]
internal static class PatchForge
{
    [HarmonyPostfix]
    private static void Postfix(decimal amount, Player player, AbstractModel source)
    {
        try
        {
            if (amount <= 0 || source == null) return;
            // ForgeCmd.Forge carries the owning player explicitly; the
            // forge row is tagged with that player's slot.
            var sourceId = source.Id?.Entry ?? "";
            if (string.IsNullOrEmpty(sourceId)) return;
            int kind;
            if (source is RelicModel) kind = ProfilerNative.ContextKindRelic;
            else if (source is PowerModel) kind = ProfilerNative.ContextKindPower;
            else kind = 0;
            ProfilerNative.OnForge(sourceId, kind, (int)amount, SpireProfilerMod.PlayerSlot(player));
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] Forge: {ex}"); }
    }
}

/// <summary>
/// Doom kill attribution: capture each doomed creature's HP before
/// DoomPower.DoomKill executes, attribute the HP as damage after. The
/// prefix/postfix pair brackets only the call; attribution itself (FIFO
/// doom layers per creature, active-context fallback) lives in the core.
/// </summary>
[HarmonyPatch(typeof(DoomPower), nameof(DoomPower.DoomKill))]
internal static class PatchDoomKill
{
    [HarmonyPrefix]
    private static void Prefix(IReadOnlyList<Creature> creatures)
    {
        try
        {
            if (creatures == null) return;
            foreach (var creature in creatures)
            {
                if (creature == null || !creature.IsAlive) continue;
                int hp = (int)creature.CurrentHp;
                if (hp > 0) ProfilerNative.OnDoomTargetCapture(creature.GetHashCode(), hp);
            }
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] DoomKill prefix: {ex}"); }
    }

    [HarmonyPostfix]
    private static void Postfix()
    {
        try { ProfilerNative.OnDoomKillsCompleted(); }
        catch (Exception ex) { Log.Error($"[SpireProfiler] DoomKill postfix: {ex}"); }
    }
}

/// <summary>
/// Osty summon tracking: record each OstyCmd.Summon's HP and source so
/// absorbed damage can be attributed back to the summoning cards/relics.
/// </summary>
[HarmonyPatch(typeof(OstyCmd), nameof(OstyCmd.Summon))]
internal static class PatchOstySummon
{
    [HarmonyPostfix]
    private static void Postfix(Player summoner, decimal amount, AbstractModel source)
    {
        try
        {
            int hpAmount = (int)amount;
            if (hpAmount <= 0) return;
            // Osty is strictly per-player: OstyCmd.Summon carries the
            // summoning player; every player's summons carry the summoner's
            // slot so the core keeps one Osty stack per player.
            string sourceId = "";
            int kind = 0;
            if (source is CardModel card)
            {
                sourceId = card.Id?.Entry ?? "";
            }
            else if (source is RelicModel relic)
            {
                sourceId = relic.Id?.Entry ?? "";
                kind = ProfilerNative.ContextKindRelic;
            }
            else if (source is PowerModel power)
            {
                sourceId = power.Id?.Entry ?? "";
                kind = ProfilerNative.ContextKindPower;
            }
            // With no model source, the core resolves the active card/context.
            ProfilerNative.OnOstySummoned(sourceId, kind, hpAmount, SpireProfilerMod.PlayerSlot(summoner));
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] OstySummon: {ex}"); }
    }
}

/// <summary>
/// Deaths flow through both CreatureCmd.Kill overloads: the Osty branch
/// clears the owner's unabsorbed-HP pool when the pet dies (sacrifice
/// card, combat death), and the player branch flags the slot's death for
/// the core's team-result label. Damage kills reach the game's Kill
/// through the IReadOnlyCollection overload (CreatureCmd.Damage collects
/// the killed creatures and kills them in one batch), while direct kills
/// (DoomKill, SetCurrentHp, the abandon force-kill) go through the
/// single-creature overload — so BOTH
/// overloads are patched with the same prefix. The single-creature
/// overload delegates to the collection one, so a direct kill fires the
/// prefix twice; the core treats player_died idempotently and a cleared
/// Osty stack clears again as a no-op.
/// </summary>
[HarmonyPatch]
internal static class PatchCreatureKilled
{
    [HarmonyPatch(typeof(CreatureCmd), nameof(CreatureCmd.Kill), new Type[] { typeof(Creature), typeof(bool) })]
    [HarmonyPrefix]
    private static void KillPrefix(Creature creature)
    {
        try { ForwardKill(creature); }
        catch (Exception ex) { Log.Error($"[SpireProfiler] CreatureKill: {ex}"); }
    }

    [HarmonyPatch(typeof(CreatureCmd), nameof(CreatureCmd.Kill), new Type[] { typeof(IReadOnlyCollection<Creature>), typeof(bool) })]
    [HarmonyPrefix]
    private static void KillManyPrefix(IReadOnlyCollection<Creature> creatures)
    {
        try
        {
            if (creatures == null) return;
            foreach (var creature in creatures) ForwardKill(creature);
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] CreatureKillMany: {ex}"); }
    }

    private static void ForwardKill(Creature creature)
    {
        if (creature == null) return;
        // No locality filter — the patch fires on every peer for the whole
        // team's creatures. The Osty's slot is its single-assignment
        // PetOwner (already the Player); the dying player's slot is
        // creature.Player.
        if (creature.Monster is Osty)
            ProfilerNative.OnOstyKilled(SpireProfilerMod.PlayerSlot(creature.PetOwner));
        else if (creature.IsPlayer)
            ProfilerNative.OnPlayerDied(SpireProfilerMod.PlayerSlot(creature.Player));
    }
}

/// <summary>
/// Power application recording: SetAmount deltas attribute to the active
/// source (positive) or are forwarded as decreases with the player flag
/// (negative — the flag lets the core treat a player Strength decrease as
/// a temporary-power expiry consuming the source table FIFO, while an
/// enemy Strength decrease stays a recorded reduction).
/// </summary>
[HarmonyPatch(typeof(PowerModel), nameof(PowerModel.SetAmount))]
internal static class PatchPowerApply
{
    [HarmonyPrefix]
    private static void Prefix(PowerModel __instance, out int __state)
    {
        __state = 0;
        try { __state = __instance?.Amount ?? 0; }
        catch (Exception ex) { Log.Error($"[SpireProfiler] PowerApply prefix: {ex}"); }
    }
    [HarmonyPostfix]
    private static void Postfix(PowerModel __instance, int amount, int __state)
    {
        try
        {
            if (__instance == null || amount == __state) return;
            var powerId = __instance.Id?.Entry;
            if (string.IsNullOrEmpty(powerId)) return;
            var owner = __instance.Owner;
            if (owner == null) return;
            // The owner is the creature the power sits ON. Every player's
            // and enemy's applications land in the team-merged power-source
            // table, tagged with the owning player's slot when the owner is
            // a player creature, else 0 (enemy powers have no player owner
            // — the applier still resolves through the core's ambient
            // per-slot state).
            ulong creatureHash = (ulong)owner.GetHashCode();
            bool isPlayer = owner.IsPlayer;
            int playerSlot = owner.IsPlayer ? SpireProfilerMod.PlayerSlot(owner.Player) : 0;
            if (amount > __state)
                ProfilerNative.OnPowerApplied(powerId, amount - __state, creatureHash, isPlayer, playerSlot);
            else
                ProfilerNative.OnPowerDecreased(powerId, __state - amount, creatureHash, isPlayer, playerSlot);
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] PowerApply postfix: {ex}"); }
    }
}
/// <summary>
/// Damage decomposition: re-runs each modifier's additive/multiplicative
/// contribution on the player->enemy hit and forwards it to the core,
/// which
/// attributes the share to the power's/relic's appliers (the card that
/// played Demon Form keeps the Strength bonus).
/// </summary>
[HarmonyPatch(typeof(Hook), nameof(Hook.ModifyDamage))]
internal static class PatchModifyDamage
{
    [HarmonyPrefix]
    private static void Prefix(decimal damage, Creature target, Creature dealer, out decimal __state)
    {
        __state = damage;
        // Enemy→player hits: capture the base damage and the dealer's
        // current Strength so the core can prorate Strength-reduction
        // mitigation when the hit lands. (ModifyDamage also fires for
        // intent recalcs; the core consumes the capture on the next real
        // hit, so a stale value never accumulates phantom mitigation.)
        // This capture is deliberately LOCAL: it feeds the local player's
        // mitigation math only, so it keeps the one locality check left in
        // the shim (IsLocalPlayer) rather than being slot-tagged.
        try
        {
            if (dealer == null || dealer.IsPlayer || target == null || !target.IsPlayer) return;
            if (!SpireProfilerMod.IsLocalPlayer(target.Player)) return;
            var str = dealer.GetPower<StrengthPower>();
            ProfilerNative.OnEnemyHitContext((int)damage, (int)(str?.Amount ?? 0));
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] ModifyDamage prefix: {ex}"); }
    }
    [HarmonyPostfix]
    private static void Postfix(decimal __result, decimal __state,
        Creature target, Creature dealer, ValueProp props, CardModel cardSource,
        IEnumerable<AbstractModel> modifiers, CardPreviewMode previewMode)
    {
        try
        {
            if (previewMode != CardPreviewMode.None) return;
            if (dealer == null || !dealer.IsPlayer || target == null || target.IsPlayer) return;
            if (!props.HasFlag(ValueProp.Move) || props.HasFlag(ValueProp.Unpowered)) return;
            decimal totalBonus = __result - __state;
            if (totalBonus <= 0 || modifiers == null) return;
            // Every player's hit contributes (team-as-one-player); the
            // dealer's slot keeps the core's pending contribs per slot so
            // one player's queued modifiers can't attach to another
            // player's next hit.
            int dealerSlot = SpireProfilerMod.PlayerSlot(dealer.Player);
            Action<string, int, int> contribute =
                (id, kind, value) => ProfilerNative.OnDamageModifierContribution(id, kind, value, dealerSlot);
            // The game applies the attacking card's enchantment before the
            // listener modifiers (Hook.ModifyDamage, hook-type flags are All
            // on every live call site), so the decomposition starts from the
            // post-enchantment value. The enchantment's own bonus is not a
            // modifier-list entry and stays with the attacking card.
            decimal start = __state;
            var enchantment = cardSource?.Enchantment;
            if (enchantment != null)
            {
                start += enchantment.EnchantDamageAdditive(start, props);
                start *= enchantment.EnchantDamageMultiplicative(start, props);
            }
            ModifierDecomposition.ForwardContributions(
                modifiers,
                start,
                __result,
                (power, baseValue) => power.ModifyDamageAdditive(target, baseValue, props, dealer, cardSource, null),
                (power, baseValue) => power.ModifyDamageMultiplicative(target, baseValue, props, dealer, cardSource, null),
                (relic, baseValue) => relic.ModifyDamageAdditive(target, baseValue, props, dealer, cardSource, null),
                (relic, baseValue) => relic.ModifyDamageMultiplicative(target, baseValue, props, dealer, cardSource, null),
                isDamage: true,
                contribute: contribute,
                // VulnerablePower's multiplicative step is a COMPOSITE of the
                // nested ModifyVulnerableMultiplier hooks (PaperPhrog,
                // CrueltyPower, DebilitatePower) — none of them override
                // ModifyDamage*, so they never appear in `modifiers`.
                // Intercept the step so each nested contributor (e.g.
                // Cruelty's damage scaling) gets its own share of the
                // marginal instead of it all going to Vulnerable's appliers.
                interceptMultiplicative: (power, multiplier, runningBefore) =>
                    power is VulnerablePower vulnerable &&
                    VulnerableDecomposition.Forward(
                        vulnerable, target, dealer, props, cardSource, runningBefore, multiplier, contribute));
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] ModifyDamage: {ex}"); }
    }
}
/// <summary>
/// Block decomposition: mirrors PatchModifyDamage for Hook.ModifyBlock —
/// each modifier's (Dexterity etc.) contribution to a block gain is
/// forwarded so the core can attach it to the block-pool chunk and credit
/// it only when the block actually absorbs damage.
/// </summary>
[HarmonyPatch(typeof(Hook), nameof(Hook.ModifyBlock))]
internal static class PatchModifyBlock
{
    [HarmonyPrefix]
    private static void Prefix(decimal block, out decimal __state)
    {
        __state = block;
    }
    [HarmonyPostfix]
    private static void Postfix(decimal __result, decimal __state,
        Creature target, ValueProp props, CardModel cardSource, CardPlay cardPlay,
        IEnumerable<AbstractModel> modifiers)
    {
        try
        {
            if (target == null || !target.IsPlayer) return;
            decimal totalBonus = __result - __state;
            if (totalBonus <= 0 || modifiers == null) return;
            // Every player's block modifiers contribute; the target's slot
            // keeps pending block contribs with the right player's block
            // pool.
            int targetSlot = SpireProfilerMod.PlayerSlot(target.Player);
            // Mirror Hook.ModifyBlock's enchantment pre-step so the
            // decomposition starts from the post-enchantment value (the
            // enchantment's own bonus stays with the blocking card).
            decimal start = __state;
            var enchantment = cardSource?.Enchantment;
            if (enchantment != null)
            {
                start += enchantment.EnchantBlockAdditive(start);
                start *= enchantment.EnchantBlockMultiplicative(start);
            }
            ModifierDecomposition.ForwardContributions(
                modifiers,
                start,
                __result,
                (power, baseValue) => power.ModifyBlockAdditive(target, baseValue, props, cardSource, cardPlay),
                (power, baseValue) => power.ModifyBlockMultiplicative(target, baseValue, props, cardSource, cardPlay),
                (relic, baseValue) => relic.ModifyBlockAdditive(target, baseValue, props, cardSource, cardPlay),
                (relic, baseValue) => relic.ModifyBlockMultiplicative(target, baseValue, props, cardSource, cardPlay),
                isDamage: false,
                contribute: (id, kind, value) => ProfilerNative.OnBlockModifierContribution(id, kind, value, targetSlot));
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] ModifyBlock: {ex}"); }
    }
}

/// Shared modifier-decomposition loop for the ModifyDamage/ModifyBlock
/// postfixes. Re-runs the game's own resolution (Hook.ModifyDamage /
/// ModifyBlock apply every listener's additive in order, then every
/// multiplicative in order, over the post-enchantment start value the
/// caller passes as `baseValue`) and credits each step with its STEP
/// MARGINAL — the amount the game's running value actually grew when the
/// step fired: an additive owns its raw delta, a multiplicative m owns
/// runningBefore·(m−1). The shares sum exactly to the bonus the listed
/// modifiers produced, so simultaneous multiplicative bonuses no longer
/// over-credit one another the way the old per-modifier result−result/m
/// formula did (each share is also strictly smaller for all but the last
/// step). Sub-1 multipliers (Weak, Frail) reduce the running value and are
/// deliberately never credited, but they still advance it so later
/// marginals match the game. All shipped probes are amount-independent
/// (verified against the decompiled models), so re-probing reproduces the
/// game's deltas exactly; `result` only bounds marginals when a damage CAP
/// clamped the final value below the re-run running value.
/// The probes and callback are injected because the two hooks differ only
/// in probe method names (ModifyDamage*/ModifyBlock*), the probe arguments
/// (damage passes the dealer and a trailing null cardPlay), the additive
/// semantics (damage forwards |additive| — a negative additive still
/// contributes, e.g. Strength-loss mitigation; block forwards positive
/// additive only), and the export name. `interceptMultiplicative` (damage
/// only) lets the caller take over a power's multiplicative step — the
/// Vulnerable composite — and receives the probed multiplier and the
/// running value before the step; returning true skips the generic credit.
/// No shipped model overrides both the additive and the multiplicative
/// probe, so routing each list entry to exactly one of them is safe.
/// Plain helper class — no class-level [HarmonyPatch], so the auto-patch
/// loop skips it.
internal static class ModifierDecomposition
{
    internal static void ForwardContributions(
        IEnumerable<AbstractModel> modifiers,
        decimal baseValue,
        decimal result,
        Func<PowerModel, decimal, decimal> powerAdditive,
        Func<PowerModel, decimal, decimal> powerMultiplicative,
        Func<RelicModel, decimal, decimal> relicAdditive,
        Func<RelicModel, decimal, decimal> relicMultiplicative,
        bool isDamage,
        Action<string, int, int> contribute,
        Func<PowerModel, decimal, decimal, bool> interceptMultiplicative = null)
    {
        // Pass 1: additive shares in the game's application order. `running`
        // tracks the game's own value so pass 2 starts from the same
        // post-additive base the game multiplied.
        decimal running = baseValue;
        var multiplicatives = new List<(AbstractModel Model, string Id, int Kind)>();
        foreach (var mod in modifiers)
        {
            string id;
            int kind;
            decimal additive;
            if (mod is PowerModel power)
            {
                id = power.Id?.Entry;
                kind = ProfilerNative.ContextKindPower;
                additive = powerAdditive(power, running);
            }
            else if (mod is RelicModel relic)
            {
                id = relic.Id?.Entry;
                kind = ProfilerNative.ContextKindRelic;
                additive = relicAdditive(relic, running);
            }
            else
            {
                continue;
            }
            if (string.IsNullOrEmpty(id)) continue;
            running += additive;
            if (isDamage ? additive != 0m : additive > 0m)
            {
                contribute(id, kind, isDamage ? Math.Abs((int)additive) : (int)additive);
                continue;
            }
            multiplicatives.Add((mod, id, kind));
        }
        // Pass 2: multiplicative step marginals in the game's application
        // order. running advances by every listed multiplier — including
        // uncredited sub-1 steps — so each marginal is computed at the value
        // the game actually had when the step fired.
        foreach (var (mod, id, kind) in multiplicatives)
        {
            decimal multiplier = mod is PowerModel power
                ? powerMultiplicative(power, running)
                : relicMultiplicative((RelicModel)mod, running);
            decimal runningBefore = running;
            running *= multiplier;
            if (multiplier <= 1m) continue;
            if (mod is PowerModel p &&
                interceptMultiplicative != null &&
                interceptMultiplicative(p, multiplier, runningBefore > result ? result : runningBefore))
            {
                continue;
            }
            int contribution = (int)((runningBefore > result ? result : runningBefore) * (multiplier - 1m));
            if (contribution > 0)
                contribute(id, kind, contribution);
        }
    }
}

/// Vulnerable decomposition: VulnerablePower.ModifyDamageMultiplicative folds
/// the nested ModifyVulnerableMultiplier hooks (PaperPhrog, CrueltyPower,
/// DebilitatePower) into the single multiplier it returns, so the generic
/// modifier loop can only see — and credit — the composite. This helper
/// re-runs the game's own composition (the body of
/// VulnerablePower.ModifyDamageMultiplicative: same contributor order, same
/// public probes, all side-effect-free) and splits the step marginal
/// linearly in multiplier space: the composite step added
/// runningBefore·(M−1) to the damage, and a nested step that added `delta`
/// to the multiplier owns runningBefore·delta of it. The parts sum to the
/// step marginal the generic path would have forwarded (up to int
/// truncation), so Vulnerable's appliers keep exactly the base share and
/// e.g. Cruelty's scaling is no longer folded into it. If the re-run does
/// not reproduce the probed composite (the game changed the composition),
/// fall back to crediting the whole marginal to Vulnerable — a stale mirror
/// must never drop the bonus.
/// Plain helper class — no class-level [HarmonyPatch], so the auto-patch
/// loop skips it.
internal static class VulnerableDecomposition
{
    internal static bool Forward(
        VulnerablePower vulnerable,
        Creature target,
        Creature dealer,
        ValueProp props,
        CardModel cardSource,
        decimal runningBefore,
        decimal composite,
        Action<string, int, int> contribute)
    {
        var vulnerableId = vulnerable.Id?.Entry;
        if (string.IsNullOrEmpty(vulnerableId)) return false;
        if (composite <= 1m) return true;

        // The pre-decomposition behavior: the whole step marginal to
        // Vulnerable's appliers.
        void Fallback()
        {
            int contribution = (int)(runningBefore * (composite - 1m));
            if (contribution > 0)
                contribute(vulnerableId, ProfilerNative.ContextKindPower, contribution);
        }

        // "DamageIncrease" is VulnerablePower's private DynamicVars key for
        // the 1.5x base multiplier; the mismatch fallback covers a rename.
        if (!vulnerable.DynamicVars.TryGetValue("DamageIncrease", out var damageIncrease))
        {
            Fallback();
            return true;
        }
        decimal running = damageIncrease.BaseValue;
        decimal vulnerableDelta = running - 1m;
        var parts = new List<(string Id, int Kind, decimal Delta)>();

        // The probes below mirror VulnerablePower.ModifyDamageMultiplicative
        // step for step, in the game's own order: PaperPhrog (dealer's
        // relic), CrueltyPower (dealer or its pet owner), DebilitatePower
        // (target).
        var paperPhrog = dealer.Player?.GetRelic<PaperPhrog>();
        if (paperPhrog?.Id?.Entry is string phrogId)
        {
            decimal after = paperPhrog.ModifyVulnerableMultiplier(target, running, props, dealer, cardSource);
            if (after != running) { parts.Add((phrogId, ProfilerNative.ContextKindRelic, after - running)); running = after; }
        }
        var cruelty = dealer.GetPower<CrueltyPower>() ?? dealer.PetOwner?.Creature.GetPower<CrueltyPower>();
        if (cruelty?.Id?.Entry is string crueltyId)
        {
            decimal after = cruelty.ModifyVulnerableMultiplier(target, running, props, dealer, cardSource);
            if (after != running) { parts.Add((crueltyId, ProfilerNative.ContextKindPower, after - running)); running = after; }
        }
        var debilitate = target.GetPower<DebilitatePower>();
        if (debilitate?.Id?.Entry is string debilitateId)
        {
            decimal after = debilitate.ModifyVulnerableMultiplier(target, running, props, dealer, cardSource);
            if (after != running) { parts.Add((debilitateId, ProfilerNative.ContextKindPower, after - running)); running = after; }
        }

        if (running != composite || vulnerableDelta < 0m)
        {
            Fallback();
            return true;
        }
        int vulnerableContribution = (int)(runningBefore * vulnerableDelta);
        if (vulnerableContribution > 0)
            contribute(vulnerableId, ProfilerNative.ContextKindPower, vulnerableContribution);
        foreach (var (id, kind, delta) in parts)
        {
            int contribution = (int)(runningBefore * delta);
            if (contribution > 0)
                contribute(id, kind, contribution);
        }
        return true;
    }
}

/// <summary>
/// Buff mitigation: Buffer/Intangible/HardenedShell reduce HP loss through
/// their ModifyHpLost* overrides; the prevented delta forwards to the core,
/// which credits the buff's appliers.
/// </summary>
[HarmonyPatch]
internal static class PatchBuffMitigation
{
    [HarmonyPatch(typeof(BufferPower), nameof(BufferPower.ModifyHpLostAfterOstyLate))]
    [HarmonyPrefix]
    private static void BufferPrefix(decimal amount, out decimal __state) { __state = amount; }
    [HarmonyPatch(typeof(BufferPower), nameof(BufferPower.ModifyHpLostAfterOstyLate))]
    [HarmonyPostfix]
    private static void BufferPostfix(decimal __result, decimal __state, Creature target)
    {
        try
        {
            // Buff mitigation counts for every player (the spec keeps the
            // mitigation events slotless).
            if (__state > 0 && __result == 0 && target.IsPlayer)
                ProfilerNative.OnBuffMitigation("BUFFER_POWER", (int)__state);
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] Buffer mitigation: {ex}"); }
    }
    [HarmonyPatch(typeof(IntangiblePower), nameof(IntangiblePower.ModifyHpLostAfterOsty))]
    [HarmonyPrefix]
    private static void IntangiblePrefix(decimal amount, out decimal __state) { __state = amount; }
    [HarmonyPatch(typeof(IntangiblePower), nameof(IntangiblePower.ModifyHpLostAfterOsty))]
    [HarmonyPostfix]
    private static void IntangiblePostfix(decimal __result, decimal __state, Creature target)
    {
        try
        {
            if (__state > __result && __result >= 0 && target.IsPlayer)
                ProfilerNative.OnBuffMitigation("INTANGIBLE_POWER", (int)(__state - __result));
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] Intangible mitigation: {ex}"); }
    }
    [HarmonyPatch(typeof(HardenedShellPower), nameof(HardenedShellPower.ModifyHpLostBeforeOstyLate))]
    [HarmonyPrefix]
    private static void HardenedShellPrefix(decimal amount, out decimal __state) { __state = amount; }
    [HarmonyPatch(typeof(HardenedShellPower), nameof(HardenedShellPower.ModifyHpLostBeforeOstyLate))]
    [HarmonyPostfix]
    private static void HardenedShellPostfix(decimal __result, decimal __state, Creature target)
    {
        try
        {
            if (__state > __result && __result >= 0 && target.IsPlayer)
                ProfilerNative.OnBuffMitigation("HARDENED_SHELL_POWER", (int)(__state - __result));
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] HardenedShell mitigation: {ex}"); }
    }
}
/// <summary>
/// Wraps orb passive/evoke trigger entries with prefix-only fallback-source
/// activation. Orb damage carries no card source, so the channeling source
/// (recorded by PatchOrbChanneled) must be reactivated when the orb acts.
/// </summary>
internal static class OrbPatcher
{
    [HarmonyPrefix]
    private static void OrbInstancePrefix(OrbModel __instance)
    {
        try
        {
            // Every player's orb triggers activate their own slot's orb
            // fallback (the owner's slot, like PatchOrbChanneled).
            if (__instance == null) return;
            ProfilerNative.OnOrbContextBegin(__instance.GetHashCode(), SpireProfilerMod.PlayerSlot(__instance.Owner));
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] orb prefix: {ex}"); }
    }
    [HarmonyPrefix]
    private static void OrbCmdPassivePrefix(OrbModel orb)
    {
        try
        {
            if (orb == null) return;
            ProfilerNative.OnOrbContextBegin(orb.GetHashCode(), SpireProfilerMod.PlayerSlot(orb.Owner));
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] OrbCmd.Passive prefix: {ex}"); }
    }
    public static void PatchAll(Harmony harmony)
    {
        var instancePrefix = new HarmonyMethod(typeof(OrbPatcher).GetMethod("OrbInstancePrefix", BindingFlags.NonPublic | BindingFlags.Static));
        var cmdPrefix = new HarmonyMethod(typeof(OrbPatcher).GetMethod("OrbCmdPassivePrefix", BindingFlags.NonPublic | BindingFlags.Static));
        TryPatch(harmony, typeof(OrbCmd), "Passive", cmdPrefix);
        var turnEndOrbs = new[] { typeof(LightningOrb), typeof(FrostOrb), typeof(DarkOrb), typeof(GlassOrb) };
        foreach (var t in turnEndOrbs) TryPatch(harmony, t, "BeforeTurnEndOrbTrigger", instancePrefix);
        TryPatch(harmony, typeof(PlasmaOrb), "AfterTurnStartOrbTrigger", instancePrefix);
        var evokers = new[] { typeof(LightningOrb), typeof(FrostOrb), typeof(DarkOrb), typeof(GlassOrb), typeof(PlasmaOrb) };
        foreach (var t in evokers) TryPatch(harmony, t, "Evoke", instancePrefix);
    }
    private static void TryPatch(Harmony harmony, Type type, string methodName, HarmonyMethod prefix)
    {
        try
        {
            var method = AccessTools.Method(type, methodName);
            if (method == null)
            {
                Log.Warn($"[SpireProfiler] orb: {type.Name}.{methodName} not found, skipping");
                return;
            }
            harmony.Patch(method, prefix, null);
        }
        catch (Exception ex)
        {
            Log.Warn($"[SpireProfiler] orb: failed {type.Name}.{methodName}: {ex.Message}");
        }
    }
}

// ── Run-history screen ──────────────────────────────────────────────────────
// The screen displays one RunHistory per open (left/right arrows switch via
// RefreshAndSelectRun); these postfixes forward the displayed run's identity
// to the core, which matches it against the profiler's own run records, and
// keep the selection scoped to the screen's lifecycle. The run panel +
// toggle button attach lazily on the first display.

/// <summary>
/// DisplayRun(RunHistory) fires for every displayed run — initial open
/// and each left/right switch. The postfix reads the
/// displayed run straight from the argument (Seed + StartTime are the join
/// keys; identical seed provenance on both sides via RunRngSet.StringSeed)
/// and forwards them with the active profile id.
/// </summary>
[HarmonyPatch(typeof(NRunHistory), "DisplayRun")]
internal static class PatchRunHistoryDisplay
{
    [HarmonyPostfix]
    private static void Postfix(NRunHistory __instance, RunHistory history)
    {
        try
        {
            ProfilerNative.OnRunHistorySelect(
                history?.Seed ?? "",
                history?.StartTime ?? 0,
                SpireProfilerMod.CurrentProfileId());
            SpireProfilerMod.AttachRunPanelTo(__instance);
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] RunHistoryDisplay: {ex}"); }
    }
}

/// <summary>
/// OnSubmenuOpened fires only on a fresh push. The clear must be a
/// PREFIX, not a postfix: despite the `TaskHelper.RunSafely` wrapper,
/// `RefreshAndSelectRun` is synchronous (no await before `DisplayRun`),
/// so the initial `DisplayRun` — and
/// our select postfix — runs INSIDE the original method. A postfix clear
/// would run after that select and blank the screen-open flag, breaking F8
/// on the first displayed run until an arrow flip re-selects. Clearing
/// first drops any stale selection before the body loads the first run,
/// whose `DisplayRun` postfix then re-selects (a failed load keeps the
/// screen marked closed, so no stale numbers render).
/// </summary>
[HarmonyPatch(typeof(NRunHistory), nameof(NRunHistory.OnSubmenuOpened))]
internal static class PatchRunHistoryOpened
{
    [HarmonyPrefix]
    private static void Prefix()
    {
        try { ProfilerNative.OnRunHistoryClear(); }
        catch (Exception ex) { Log.Error($"[SpireProfiler] RunHistoryOpened: {ex}"); }
    }
}

/// <summary>
/// The screen's close path is the NSubmenu.OnSubmenuClosed virtual
/// (popped from its stack); NRunHistory does not override it, so the
/// patch targets the base virtual and filters on the
/// instance. Only the run-history screen's own pop clears — a submenu
/// closing on top of it must not blank a still-displayed run (which only
/// re-selects on the next arrow flip or re-push).
/// </summary>
[HarmonyPatch(typeof(NSubmenu), nameof(NSubmenu.OnSubmenuClosed))]
internal static class PatchRunHistoryClosed
{
    [HarmonyPostfix]
    private static void Postfix(NSubmenu __instance)
    {
        try
        {
            if (!(__instance is NRunHistory)) return;
            ProfilerNative.OnRunHistoryClear();
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] RunHistoryClosed: {ex}"); }
    }
}

/// <summary>
/// The run-end chokepoint: victory (WinRun), all-dead defeat, and abandon
/// (the force-kill that ends an abandoned run) all funnel through
/// RunManager.OnEnded on every peer. OnEnded's bool cannot distinguish
/// abandon from defeat, but RunManager.IsAbandoned can — the force-kill
/// leaves the flag set — so the postfix maps the three run terminals to
/// 0 = victory, 1 = defeat, 2 = abandoned. OnEnded can fire twice
/// (victory's follow-up all-dead kill); the second run_ended is a
/// core-side no-op because the record is already closed. Save&quit and
/// multiplayer-disconnect do not reach OnEnded and stay handled by the
/// suspend patches below.
/// </summary>
[HarmonyPatch(typeof(RunManager), nameof(RunManager.OnEnded))]
internal static class PatchRunEnded
{
    [HarmonyPostfix]
    private static void Postfix(RunManager __instance, bool isVictory)
    {
        try
        {
            int outcome = isVictory
                ? 0
                : (__instance != null && __instance.IsAbandoned ? 2 : 1);
            ProfilerNative.OnRunEnded(outcome);
            Log.Info($"[SpireProfiler] run ended, outcome={outcome}");
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] RunEnded: {ex}"); }
    }
}

/// <summary>
/// Save & exit forwards run_suspended, not run_ended: the save-and-quit
/// path (NPauseMenu → CloseToMenu → NGame.ReturnToMainMenu) never
/// reaches RunManager.OnEnded, so without this postfix the core
/// would keep the run active — the combat panel stays visible on the main
/// menu, and the next continue's run_started closes the stale run as a
/// spurious defeat. The postfix targets RunManager.CleanUp, the
/// synchronous teardown both menu-exit funnels (ReturnToMainMenu and
/// GoToTimeline) pass through, rather than the async ReturnToMainMenu. A
/// run that truly ended (victory/defeat/abandon) already cleared `active`,
/// so the forwarded suspend is a core-side no-op.
/// </summary>
[HarmonyPatch(typeof(RunManager), nameof(RunManager.CleanUp))]
internal static class PatchRunSuspend
{
    [HarmonyPostfix]
    private static void Postfix()
    {
        try
        {
            ProfilerNative.OnRunSuspended();
            Log.Info("[SpireProfiler] run suspended (save & quit); no record written");
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] RunManager.CleanUp: {ex}"); }
    }
}

/// <summary>
/// A host quit or a dropped connection sends the client back to the main
/// menu with no end-of-run signal (LocalPlayerDisconnected →
/// ReturnToMainMenuWithError) — no OnEnded. The
/// disconnect reason cannot distinguish "host saved and quit" (the run is
/// resumable) from "host quit without saving", so the run must be
/// SUSPENDED, not closed: run_suspended deactivates without writing a
/// record, and a later resume rejoins the same run id by seed (closing as
/// defeat here would split one run across two runs.json entries). The
/// game-over case never reaches this forward: QuitGameOver disconnects are
/// skipped below, and an already-abandoned run is closed by the OnEnded
/// postfix. StateDivergence disconnects suspend as well (the stale record
/// then closes as a loss at the next run start).
/// </summary>
[HarmonyPatch(typeof(RunManager), nameof(RunManager.LocalPlayerDisconnected))]
internal static class PatchRunDisconnected
{
    [HarmonyPostfix]
    private static void Postfix(NetErrorInfo info)
    {
        try
        {
            var runManager = RunManager.Instance;
            if (info.GetReason() == NetError.QuitGameOver) return;
            if (runManager == null || runManager.IsAbandoned) return;
            ProfilerNative.OnRunSuspended();
            Log.Info("[SpireProfiler] run suspended after multiplayer disconnect; no record written");
        }
        catch (Exception ex) { Log.Error($"[SpireProfiler] RunDisconnected: {ex}"); }
    }
}
